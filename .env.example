# Public client configuration. Values prefixed VITE_ are embedded in browser bundles.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Client feature flags (adjust only if the application supports them)
VITE_TOOL_HUB_ENABLED=false
VITE_MAX_TOOLS_PER_DAY=10
VITE_GAMIFICATION_ENABLED=false
RATE_LIMIT_TOOLS=10

# Server-only secret: configure only in a trusted backend/hosting secret manager.
# Never expose this value to Vite/browser code or commit a real value.
TOOL_HUB_API_KEY=
