# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
coverage/

# Lovable requires the root .env file to be committed for VITE_* build-time values.
# Only put public VITE_* values in .env; never put private credentials here.
.env
!.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local tooling
.cache/
